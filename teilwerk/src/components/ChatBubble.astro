---
// Rein dekoratives Demo-Element ohne echte Chat-Funktion — bewusst ohne
// Klick-Handler, damit kein totes UI-Versprechen entsteht.
---
<button
  type="button"
  aria-label="Live-Chat (Demo-Vorschau, nicht aktiv)"
  class="fixed bottom-20 right-20 z-40 flex size-[44px] items-center justify-center rounded-full bg-carbon-black text-paper-white shadow-md"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d="M4 5.5C4 4.67 4.67 4 5.5 4h13c.83 0 1.5.67 1.5 1.5v10c0 .83-.67 1.5-1.5 1.5H9l-4 3.5V17H5.5C4.67 17 4 16.33 4 15.5v-10Z" stroke-linejoin="round"/>
  </svg>
</button>
