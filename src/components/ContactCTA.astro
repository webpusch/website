---
import Button from '@/components/ui/Button.astro';
---
<section id="kontakt" aria-label="Kontakt" class="border-t border-concrete-gray">
  <div class="mx-auto max-w-[1440px] px-16 py-48 md:px-32 md:py-[80px]">
    <div data-reveal class="flex flex-col items-start gap-24 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="max-w-[16ch] font-akkurat text-heading uppercase text-carbon-black md:text-display">
          Bereit für ein Lager ohne Umwege?
        </h2>
        <p class="mt-16 max-w-[52ch] font-akkurat text-body text-iron-gray">
          Kontaktieren Sie uns für ein unverbindliches Angebot für Ihre Werkstatt.
        </p>
      </div>
      <Button href="#top" variant="primary" class="shrink-0">Kontakt aufnehmen</Button>
    </div>
  </div>
</section>
