---
const links = [
  { label: 'Kategorien', href: '#kategorien' },
  { label: 'Vorteile', href: '#vorteile' },
  { label: 'Kontakt', href: '#kontakt' },
];
---
<header id="top" class="sticky top-0 z-50 border-b border-concrete-gray bg-paper-white">
  <div class="mx-auto flex h-[56px] max-w-[1440px] items-center justify-between px-16 md:h-[64px] md:px-32">

    <!-- Links: Eyebrow + Nav-Links (Links ab Desktop sichtbar) -->
    <div class="flex items-center gap-24">
      <span class="font-akkurat text-label-sm uppercase tracking-[0.44px] text-carbon-black">Teilwerk</span>
      <nav aria-label="Hauptnavigation" class="hidden items-center gap-20 md:flex">
        {links.map((link) => (
          <a
            href={link.href}
            class="font-akkurat text-label-sm uppercase tracking-[0.44px] text-carbon-black hover:text-ash-gray"
          >{link.label}</a>
        ))}
      </nav>
    </div>

    <!-- Mitte: Logo-Plakette -->
    <a href="#top" aria-label="Teilwerk — Startseite" class="absolute left-1/2 -translate-x-1/2">
      <span class="flex h-[32px] items-center rounded-2xl bg-carbon-black px-16 font-akkurat text-label-sm uppercase tracking-[0.44px] text-paper-white">
        Teilwerk
      </span>
    </a>

    <!-- Rechts: Utility-Icons (dekorativ, Demo ohne echte Funktion) -->
    <div class="flex items-center gap-16">
      <button type="button" aria-label="Suche (Demo)" class="text-carbon-black">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"/>
          <path d="m20 20-3.6-3.6" stroke-linecap="round"/>
        </svg>
      </button>
      <button type="button" aria-label="Warenkorb (Demo)" class="text-carbon-black">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L20.5 8H6" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="10" cy="20" r="1.3"/>
          <circle cx="17" cy="20" r="1.3"/>
        </svg>
      </button>
      <button type="button" aria-label="Konto (Demo)" class="hidden text-carbon-black sm:block">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="8.5" r="3.5"/>
          <path d="M4.5 20c1.4-3.6 4.4-5.5 7.5-5.5s6.1 1.9 7.5 5.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
</header>
